             | ((uint)block[b + 1] << 8)
             | ((uint)block[b + 2] << 16)
             | ((uint)block[b + 3] << 24);
    }
    md5_block(st.h[0], st.h[1], st.h[2], st.h[3], M);
}

/* template_finalize: the whole x01 construction.
 *
 *   stage 1  s[8]  = sha256(data, len)          -- BE state, BE message
 *   stage 2  M[16] = hex64(s) packed LE         -- the byte-order seam
 *   stage 3  h[4]  = md5(those 64 bytes)        -- TWO blocks
 *
 * After return st->h[0..3] holds the x01 MD5 digest in MD5's natural
 * little-endian word form, which is what template_digest_compare and
 * EMIT_HIT_4 expect with no byteswap. */
static inline void template_finalize(thread template_state &st,
                                device const uchar *data,
                                int len)
{
    uint M[16];
    uint s[8];
    int pos = 0;

    /* ---- stage 1: SHA-256 of the candidate ------------------------- */
    /* FIPS 180-4 5.3.3 initial hash values. */
    s[0] = 0x6a09e667u; s[1] = 0xbb67ae85u;
    s[2] = 0x3c6ef372u; s[3] = 0xa54ff53au;
    s[4] = 0x510e527fu; s[5] = 0x9b05688cu;
    s[6] = 0x1f83d9abu; s[7] = 0x5be0cd19u;

    /* Complete 64-byte blocks, message words BIG-endian. */
    while (len - pos >= HASH_BLOCK_BYTES) {
        for (int j = 0; j < 16; j++) {
            int b = pos + j * 4;
            M[j] = ((uint)data[b]     << 24)
                 | ((uint)data[b + 1] << 16)
                 | ((uint)data[b + 2] << 8)
                 |  (uint)data[b + 3];
        }
        sha256_block(&s[0], M);
        pos += HASH_BLOCK_BYTES;
    }

    /* Tail + 0x80 marker + 64-bit BE bit length. */
    {
        int rem = len - pos;              /* 0..63 */

        for (int j = 0; j < 16; j++) M[j] = 0u;

        /* BE: byte i of the block is the (3 - (i & 3))'th octet of word
         * i >> 2. */
        for (int i = 0; i < rem; i++) {
            int wi = i >> 2;
            int bi = 3 - (i & 3);
            M[wi] |= ((uint)data[pos + i]) << (bi * 8);
        }
        {
            int wi = rem >> 2;
            int bi = 3 - (rem & 3);
            M[wi] |= ((uint)0x80u) << (bi * 8);
        }

        if (rem < 56) {
            /* Length fits in this block. len < 2^29 always holds for a
             * candidate, so the high half of the bit count is zero. */
            M[14] = 0u;
            M[15] = (uint)((uint)len * 8u);
            sha256_block(&s[0], M);
        } else {
            /* One extra padding-only block to carry the length. */
            sha256_block(&s[0], M);
            for (int j = 0; j < 16; j++) M[j] = 0u;
            M[14] = 0u;
            M[15] = (uint)((uint)len * 8u);
            sha256_block(&s[0], M);
        }
    }

    /* ---- stage 2: hex64(sha256 digest), packed LE for MD5 ----------- */
    /* THE BYTE-ORDER SEAM. The characters must come out in digest byte
     * order -- for sha256 word i that is the high octet first -- while the
     * M[] words they land in are read little-endian by md5_block. Each
     * sha256 word yields 8 characters, which is exactly two M[] words, so
     * there is no carry between iterations. Mirrors prmd5(src, dst, 64). */
    for (int i = 0; i < 8; i++) {
        uint v = s[i];
        uint b0 = (v >> 24) & 0xffu;
        uint b1 = (v >> 16) & 0xffu;
        uint b2 = (v >> 8)  & 0xffu;
        uint b3 =  v        & 0xffu;

        uint n0 = (b0 >> 4),  n1 = (b0 & 0xfu);
        uint n2 = (b1 >> 4),  n3 = (b1 & 0xfu);
        uint n4 = (b2 >> 4),  n5 = (b2 & 0xfu);
        uint n6 = (b3 >> 4),  n7 = (b3 & 0xfu);

        uint c0 = n0 + ((n0 < 10u) ? (uint)'0' : (uint)('a' - 10));
        uint c1 = n1 + ((n1 < 10u) ? (uint)'0' : (uint)('a' - 10));
        uint c2 = n2 + ((n2 < 10u) ? (uint)'0' : (uint)('a' - 10));
        uint c3 = n3 + ((n3 < 10u) ? (uint)'0' : (uint)('a' - 10));
        uint c4 = n4 + ((n4 < 10u) ? (uint)'0' : (uint)('a' - 10));
        uint c5 = n5 + ((n5 < 10u) ? (uint)'0' : (uint)('a' - 10));
        uint c6 = n6 + ((n6 < 10u) ? (uint)'0' : (uint)('a' - 10));
        uint c7 = n7 + ((n7 < 10u) ? (uint)'0' : (uint)('a' - 10));

        /* LE pack: first character is the LOW octet. */
        M[i * 2]     = c0 | (c1 << 8) | (c2 << 16) | (c3 << 24);
        M[i * 2 + 1] = c4 | (c5 << 8) | (c6 << 16) | (c7 << 24);
    }

    /* ---- stage 3: MD5 of those 64 bytes, TWO blocks ---------------- */
    st.h[0] = 0x67452301u;
    st.h[1] = 0xEFCDAB89u;
    st.h[2] = 0x98BADCFEu;
    st.h[3] = 0x10325476u;
    /* Block 1: the 64 message bytes, complete -- no room for padding. */
    md5_block(st.h[0], st.h[1], st.h[2], st.h[3], M);
    /* Block 2: marker, zeros, and the bit length of a 64-byte message.
     * M[14] = 512, not 256 -- the input here is the 64-char hex of a
     * SHA-256, not the 32-char hex of an MD5 that template_iterate
     * re-hashes below. */
    M[0] = 0x80u;
    for (int j = 1; j < 14; j++) M[j] = 0u;
    M[14] = 64u * 8u;
    M[15] = 0u;
    md5_block(st.h[0], st.h[1], st.h[2], st.h[3], M);
}

