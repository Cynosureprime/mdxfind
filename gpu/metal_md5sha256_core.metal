/* template_transform: absorb one HASH_BLOCK_BYTES (64) byte block as MD5.
 * Public extension API, kept for symmetry with the other cores; the hot
 * path in template_finalize bypasses it (perf-fix lesson above). MD5 reads
 * message words little-endian. */
static inline void template_transform(thread template_state &st,
                                thread const uchar *block)
{
    uint M[16];
    for (int j = 0; j < 16; j++) {
        int b = j * 4;
