/* template_state: SHA224 uses sha256_block which writes to 8 state words.
 * Keep h[8] explicit (NOT h[HASH_WORDS]) — HASH_WORDS=7 represents the
 * emit width, not the internal state width. h[7] is computed but ignored
 * for SHA224. */
typedef struct {
    uint h[8];
} template_state;

/* template_init: install SHA224 IV (FIPS 180-4 §5.3.2). */
static inline void template_init(template_state *st) {
    st->h[0] = 0xc1059ed8u;
    st->h[1] = 0x367cd507u;
    st->h[2] = 0x3070dd17u;
    st->h[3] = 0xf70e5939u;
    st->h[4] = 0xffc00b31u;
    st->h[5] = 0x68581511u;
    st->h[6] = 0x64f98fa7u;
    st->h[7] = 0xbefa4fa4u;
}

/* template_transform: kept for API completeness — never called on the
 * hot path (template_finalize builds M[16] inline). SHA224 reads message
 * words BIG-ENDIAN. */
static inline void template_transform(template_state *st,
                                      const uchar *block)
{
    uint M[16];
    for (int j = 0; j < 16; j++) {
        int b = j * 4;
        M[j] = ((uint)block[b]     << 24)
             | ((uint)block[b + 1] << 16)
             | ((uint)block[b + 2] << 8)
             |  (uint)block[b + 3];
    }
    {{BASE_ALGO}}_block(&st->h[0], M);
}

