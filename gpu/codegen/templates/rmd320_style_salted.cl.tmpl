/* template_init: install RIPEMD-320 IV (RIPEMD-320 spec; matches gpu_-
 * ripemd320_core.cl line 82-91 + gpu_hmac_rmd320.cl line 233-234 init
 * exactly — 5 leading "MD/SHA-style" words + 5 cross-pipeline words).
 * The 10-word IV distinguishes RMD320 from RMD160 at runtime; the
 * fragment also ships a 10-word IV inside its HMAC kstate/istate/
 * ostate arrays (the IV is duplicated for HMAC because the inner /
 * outer hash each start fresh). */
static inline void template_init(template_state *st) {
    st->h[0] = 0x67452301u;
    st->h[1] = 0xEFCDAB89u;
    st->h[2] = 0x98BADCFEu;
    st->h[3] = 0x10325476u;
    st->h[4] = 0xC3D2E1F0u;
    st->h[5] = 0x76543210u;
    st->h[6] = 0xFEDCBA98u;
    st->h[7] = 0x89ABCDEFu;
    st->h[8] = 0x01234567u;
    st->h[9] = 0x3C2D1E0Fu;
}

/* template_transform: kept for API completeness — never called on the
 * hot path (template_finalize builds M[16] inline as in gpu_ripemd320_-
 * core.cl). RMD320 reads message words LITTLE-ENDIAN. */
static inline void template_transform(template_state *st,
                                      const uchar *block)
{
    uint M[16];
    for (int j = 0; j < 16; j++) {
        int b = j * 4;
        M[j] = (uint)block[b]
             | ((uint)block[b + 1] << 8)
             | ((uint)block[b + 2] << 16)
             | ((uint)block[b + 3] << 24);
    }
    {{BASE_ALGO}}_block(&st->h[0], M);
}

