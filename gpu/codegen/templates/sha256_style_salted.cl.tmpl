/* template_iterate: -i loop step. Re-encode the digest as 64-byte
 * lowercase hex ASCII and rehash with fresh IV. {{ITER_NOTE}}
 *
 * Mirrors gpu_sha256_core.cl rev 1 lines 232-272 byte-for-byte:
 *   - 8 state words -> 16 BE-encoded hex M[] words (2 words per state
 *     word, 4 hex chars each)
 *   - state reset to SHA256 IV; {{BASE_ALGO}}_block on the full hex block
 *   - SECOND block for pad+length: M[0] = 0x80000000u, M[1..14] = 0,
 *     M[15] = 64 * 8 = 512.
 *   - {{BASE_ALGO}}_block again. */
static inline void template_iterate(template_state *st)
{
    uint M[16];
    /* Inlined sha256_to_hex_lc body — keeps this core self-contained
     * (gpu_sha256_packed.cl's hex helpers are not exported through
     * gpu_common.cl). Per-byte BE hex encoding, identical to the
     * SHA1 sibling but 8 state words -> 16 M[] words (vs SHA1's 5->10). */
    for (int i = 0; i < 8; i++) {
        uint s = st->h[i];
        uint b0 = (s >> 24) & 0xff;
        uint b1 = (s >> 16) & 0xff;
        uint b2 = (s >> 8)  & 0xff;
        uint b3 = s & 0xff;
        uint hi0 = (b0 >> 4) & 0xf, lo0 = b0 & 0xf;
        uint hi1 = (b1 >> 4) & 0xf, lo1 = b1 & 0xf;
        uint hi2 = (b2 >> 4) & 0xf, lo2 = b2 & 0xf;
        uint hi3 = (b3 >> 4) & 0xf, lo3 = b3 & 0xf;
        uint h0 = ((hi0 + ((hi0 < 10) ? '0' : ('a' - 10))) << 8)
                |  (lo0 + ((lo0 < 10) ? '0' : ('a' - 10)));
        uint h1 = ((hi1 + ((hi1 < 10) ? '0' : ('a' - 10))) << 8)
                |  (lo1 + ((lo1 < 10) ? '0' : ('a' - 10)));
        uint h2 = ((hi2 + ((hi2 < 10) ? '0' : ('a' - 10))) << 8)
                |  (lo2 + ((lo2 < 10) ? '0' : ('a' - 10)));
        uint h3 = ((hi3 + ((hi3 < 10) ? '0' : ('a' - 10))) << 8)
                |  (lo3 + ((lo3 < 10) ? '0' : ('a' - 10)));
        M[i * 2]     = (h0 << 16) | h1;
        M[i * 2 + 1] = (h2 << 16) | h3;
    }
    /* Reset state to SHA256 IV; absorb the full 64-byte hex block. */
    st->h[0] = 0x6a09e667u; st->h[1] = 0xbb67ae85u;
    st->h[2] = 0x3c6ef372u; st->h[3] = 0xa54ff53au;
    st->h[4] = 0x510e527fu; st->h[5] = 0x9b05688cu;
    st->h[6] = 0x1f83d9abu; st->h[7] = 0x5be0cd19u;
    {{BASE_ALGO}}_block(&st->h[0], M);

    /* Second block: pad + length only. SHA256 hex (64 bytes) exactly fills
     * the first block, so the 0x80 marker MUST land at byte 0 of block 2.
     * Length encoded BE in M[14..15] (M[14] high 32 bits = 0; M[15] low 32
     * = 64 * 8 = 512). */
    M[0] = 0x80000000u;
    for (int j = 1; j < 15; j++) M[j] = 0u;
    M[14] = 0u;
    M[15] = 64u * 8u;       /* 64 hex chars = 512 bits */
    {{BASE_ALGO}}_block(&st->h[0], M);
}

