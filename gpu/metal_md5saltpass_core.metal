        } else {
            c = data[p - (int)slen];
        }
        M[i >> 2] |= ((uint)c) << ((i & 3) * 8);
    }
    M[rem >> 2] |= (uint)0x80 << ((rem & 3) * 8);

    if (rem < 56) {
        M[14] = (uint)(total_len * 8);
        M[15] = 0;
        md5_block(st.h[0], st.h[1], st.h[2], st.h[3], M);
    } else {
        md5_block(st.h[0], st.h[1], st.h[2], st.h[3], M);
        for (int j = 0; j < 16; j++) M[j] = 0;
        M[14] = (uint)(total_len * 8);
        M[15] = 0;
        md5_block(st.h[0], st.h[1], st.h[2], st.h[3], M);
